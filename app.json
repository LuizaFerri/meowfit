{
  "expo": {
    "name": "MeowFit",
    "slug": "meowfit",
    "version": "1.1.0",
    "scheme": "meowfit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.luiza.meowfit",
      "adaptiveIcon": {
        "backgroundColor": "#140C1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/favicon.png",
      "name": "MeowFit",
      "shortName": "MeowFit",
      "themeColor": "#7044B8",
      "backgroundColor": "#F6F1FB"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7044B8"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-lilas.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#EFDFFC"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "MeowFit · Hoje",
              "description": "Treino do dia, água e refeições",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Week",
              "label": "MeowFit · Semana",
              "description": "Dias treinados na semana e a regra das duas faltas",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Water",
              "label": "MeowFit · Água",
              "description": "Água do dia com botão de +250 ml",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "2ee748af-845c-4df6-9ea8-f4430e3a8f6d"
      }
    },
    "owner": "luiza-ferri"
  }
}
